# .htaccess
# JS/CSS: always revalidate (the bundle filenames are not hashed), but allow a cheap 304 via ETag
# instead of re-downloading the whole file on every visit.
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Images, icons, fonts and PDFs change rarely: let browsers keep them for a day.
<FilesMatch "\.(png|jpe?g|gif|svg|ico|webp|woff2?|pdf|webmanifest)$">
    Header set Cache-Control "public, max-age=86400"
</FilesMatch>

AddType application/manifest+json .webmanifest

# No cache for PHP/API
<FilesMatch "\.php$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
</FilesMatch>

# Security headers (sent on every response)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    Header always set Strict-Transport-Security "max-age=15552000"
</IfModule>

# Pass Authorization header to PHP
SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS (host-agnostic -- works for hcri.io, www.hcri.io and
    # dev.hcri.io alike without hardcoding a hostname). Any host-specific
    # canonicalization, e.g. redirecting bare hcri.io to www.hcri.io,
    # belongs outside this shared file -- see README/deploy notes.
    RewriteCond %{HTTPS} off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

    # Pass Authorization header through rewrite
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Some upload/linking tools encode spaces in filenames as a literal "+"
    # instead of %20. If the exact requested path doesn't exist as a file,
    # but it does once "+" is treated as a space, rewrite to that real path
    # so links using either encoding resolve to the same file. Runs once per
    # "+" found (via [N]) until either the file is found or none remain.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)\+(.*)$ $1%20$2 [N]

    # Never serve internal files over the web (403). Runs before the "static files" rule below, which would
    # otherwise hand them out. The app reaches these from PHP, not over HTTP.
    RewriteRule ^(database\.sql|checksums\.md5|api-test\.html|error_log|router\.php)$ - [F,L,NC]
    RewriteRule ^(sql|vendor|uploads|\.git|\.github)(/|$) - [F,L,NC]
    RewriteRule ^api/_core(/|$) - [F,L,NC]
    RewriteRule (^|/)(secrets[^/]*\.php|[^/]*\.(sql|log|md5|bak|orig|swp))$ - [F,L,NC]
    RewriteRule (^|/)\.(git|env|htaccess|htpasswd)  - [F,L,NC]

    # Static files — serve directly, never rewrite
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Static directories — serve directly
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else → index.php
    RewriteRule ^ index.php [L,QSA]
</IfModule>