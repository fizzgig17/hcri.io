<?php
// api/_core/secrets.local.php.example
//
// This is a TEMPLATE. Copy it to api/_core/secrets.local.php on the SERVER
// ONLY and fill in real values there. The real file is gitignored and must
// NEVER be committed -- that's the whole point of this file existing.
//
// db.php, mail_config.php, and auth.php each require_once this file (if it
// exists) before reading any secret via getenv(), so putenv() here is all
// that's needed -- no server/webserver config changes required.

// Database password (cPanel -> MySQL Databases -> change the user's password,
// then put the new value here)
putenv('DB_PASS=REPLACE_ME');

// Only needed if these ever differ from the defaults in db.php:
// putenv('DB_HOST=localhost');
// putenv('DB_PORT=3306');
// putenv('DB_NAME=REPLACE_ME');
// putenv('DB_USER=REPLACE_ME');

// Mailbox password (cPanel -> Email Accounts -> change password for
// fizzgig@hcri.io, then put the new value here)
putenv('MAIL_PASS=REPLACE_ME');

// Secret used to sign login session tokens. Generate a real one with:
//   php -r "echo bin2hex(random_bytes(32));"
// Changing this invalidates every currently-logged-in session (everyone has
// to log in again) -- expected and fine, especially the first time this is set.
putenv('JWT_SECRET=REPLACE_ME');
